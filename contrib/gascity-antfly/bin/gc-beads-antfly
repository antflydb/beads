#!/usr/bin/env python3
"""Gas City executable Beads provider backed by the Antfly-enabled bd build."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time

DATA_OPERATIONS = {
    "create", "get", "update", "close", "reopen", "delete", "list", "children",
    "list-by-label", "ready", "set-metadata", "dep-add", "dep-remove", "dep-list",
}


def main():
    if len(sys.argv) < 2:
        print("usage: gc-beads-antfly <operation> [arguments...]", file=sys.stderr)
        return 1
    operation = sys.argv[1]
    if operation in {"stop", "shutdown"}:
        return 2  # Embedded handles close per call; remote servers are externally owned.
    lifecycle = {"init", "start", "ensure-ready", "health", "probe", "recover"}
    if operation not in DATA_OPERATIONS | lifecycle:
        return 2
    # Gas City invokes init <scope-dir> <prefix> [legacy-database-name].
    # start owns no process: embedded handles are per call and remote servers
    # are externally managed. Initialization belongs to the explicit init op.
    if operation == "start":
        return 0
    init_root = None
    init_prefix = None
    if operation == "init" and len(sys.argv) > 2:
        if len(sys.argv) not in (4, 5):
            print("init requires <scope-dir> <prefix> [legacy-database-name]", file=sys.stderr)
            return 1
        init_root, init_prefix = sys.argv[2:4]
        if not init_root or not init_prefix:
            print("init scope and prefix must be nonempty", file=sys.stderr)
            return 1
        projected_root = os.environ.get("GC_STORE_ROOT")
        if projected_root and Path(projected_root).resolve() != Path(init_root).resolve():
            print("init scope disagrees with GC_STORE_ROOT", file=sys.stderr)
            return 1
    root = init_root or os.environ.get("GC_STORE_ROOT")
    # Store operations receive GC_STORE_ROOT. Gas City's lifecycle calls use
    # BEADS_DIR for an explicit scope, or the canonical city runtime projection
    # before that scope has been initialized.
    if not root and operation in lifecycle:
        beads_dir = os.environ.get("BEADS_DIR")
        if beads_dir:
            root = str(Path(beads_dir).resolve().parent)
        else:
            root = os.environ.get("GC_CITY_PATH") or os.environ.get("GC_CITY_ROOT")
    if not root:
        print("GC_STORE_ROOT is required for data operations; lifecycle requires a scope or city root", file=sys.stderr)
        return 1
    root = Path(root).resolve()
    if not root.is_dir():
        print("GC_STORE_ROOT must name an existing scope directory", file=sys.stderr)
        return 1
    environment = dict(os.environ)
    environment["BEADS_DIR"] = str(root / ".beads")
    binary = environment.get("ANTFLY_BD_BIN") or environment.get("BD_BIN", "bd")

    def call(arguments, **kwargs):
        return subprocess.run([binary, *arguments], cwd=root, env=environment,
                              timeout=28, check=False, **kwargs)

    if operation in {"init", "start", "ensure-ready"}:
        metadata = root / ".beads" / "metadata.json"
        if metadata.exists():
            with metadata.open() as stream:
                if json.load(stream).get("backend") != "antfly":
                    print("scope already selects another Beads backend", file=sys.stderr)
                    return 1
            if init_prefix:
                current_prefix = call(["config", "get", "issue_prefix"],
                                      stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                if current_prefix.returncode:
                    print("cannot verify native scope prefix; existing routing was retained", file=sys.stderr)
                    sys.stderr.buffer.write(current_prefix.stderr)
                    return current_prefix.returncode
                actual_prefix = current_prefix.stdout.decode().strip()
                if actual_prefix != init_prefix:
                    print(f"scope prefix {actual_prefix!r} does not match positional init prefix {init_prefix!r}; existing routing was retained", file=sys.stderr)
                    return 1
        else:
            arguments = ["antfly", "init", "--prefix", init_prefix or environment.get("GC_BEADS_PREFIX", "bd")]
            endpoint = environment.get("GC_ANTFLY_URL")
            if not endpoint and environment.get("ANTFLY_LIBRARY_PATH"):
                # Persist the explicit runtime path so a service restart does
                # not depend on inheriting the initializing shell's environment.
                library = str(Path(environment["ANTFLY_LIBRARY_PATH"]).expanduser().resolve())
                arguments.extend(["--library", library])
            if endpoint:
                workspace = environment.get("GC_ANTFLY_WORKSPACE") or (
                    "gc-" + hashlib.sha256(str(root).encode()).hexdigest()[:24]
                )
                arguments.extend(["--url", endpoint, "--workspace", workspace])
                if environment.get("GC_ANTFLY_TABLE"):
                    arguments.extend(["--table", environment["GC_ANTFLY_TABLE"]])
                if environment.get("GC_ANTFLY_TOKEN_ENV"):
                    arguments.extend(["--token-env", environment["GC_ANTFLY_TOKEN_ENV"]])
                for name in ("DATABASE", "NAMESPACE"):
                    if environment.get("GC_ANTFLY_" + name):
                        arguments.extend(["--" + name.lower(), environment["GC_ANTFLY_" + name]])
            for attempt in range(10):
                result = call(arguments, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                if result.returncode == 0 or metadata.exists():
                    break
                if attempt == 9:
                    sys.stderr.buffer.write(result.stderr)
                    return result.returncode
                time.sleep(0.1)
        return call(["antfly", "provider", "health"], stdout=subprocess.DEVNULL).returncode
    if operation in {"health", "probe", "recover"}:
        return call(["antfly", "provider", "health"]).returncode
    return call(["antfly", "provider", *sys.argv[1:]]).returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
